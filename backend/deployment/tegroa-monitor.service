[Unit]
Description=TegROA Live Network Monitor
After=network.target postgresql.service

[Service]
Type=simple
User=sayli
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK
WorkingDirectory=/home/sayli/Projects/TegROA/backend
EnvironmentFile=/home/sayli/Projects/TegROA/backend/.env
ExecStart=/home/sayli/Projects/TegROA/backend/.venv/bin/python -m app.traffic.live_capture --continuous
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
